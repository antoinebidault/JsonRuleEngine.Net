<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>2.0.0</Version>
    <Description>Simple json rule engine</Description>
    <Authors>antoinebidault</Authors>
    <Company>Dastra</Company>
    <PackageProjectUrl>https://github.com/antoinebidault/JsonRuleEngine.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/antoinebidault/JsonRuleEngine.Net</RepositoryUrl>
    <PackageIcon>JsonRuleEngine.Net.png</PackageIcon>
    <RepositoryType>Open Source</RepositoryType>
    <PackageTags>Rule engine, Json, Condition expression, C#, .NET Core</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
   </ItemGroup>

  <ItemGroup>
    <None Update="JsonRuleEngine.Net.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <!--
    AppVeyor builds this project from its UI configuration and ignores
    appveyor.yml, so the yml's `artifacts:` section never runs. Push the
    package from the build itself instead. No-op outside AppVeyor.
  -->
  <Target Name="PushPackageToAppVeyor" AfterTargets="Pack" Condition="'$(APPVEYOR)' != ''">
    <Exec Command="appveyor PushArtifact &quot;%(NuGetPackOutput.FullPath)&quot; -DeploymentName &quot;NuGet package&quot;"
          Condition="'%(NuGetPackOutput.Extension)' == '.nupkg'"
          ContinueOnError="true" />
  </Target>

</Project>